{
  "$schema": "https://json.schemastore.org/claude-code-plugin-manifest.json",
  "name": "justsend",
  "displayName": "JustSend Work Memory",
  "version": "0.11.1",
  "description": "Work records and a verification contract for coding agents: one record per task_key, evidence that has to exist before a task can be called done.",
  "author": {
    "name": "clab-one",
    "url": "https://github.com/clab-one"
  },
  "homepage": "https://github.com/clab-one/justsend-plugin",
  "repository": "https://github.com/clab-one/justsend-plugin",
  "license": "MIT",
  "keywords": [
    "work-log",
    "memory",
    "justsend",
    "verification",
    "evidence"
  ],
  "mcpServers": {
    "contract": {
      "type": "stdio",
      "command": "${CLAUDE_PLUGIN_ROOT}/mcp/run.sh"
    }
  }
}
