{
  "$schema": "https://json.schemastore.org/claude-code-plugin-manifest.json",
  "name": "justsend",
  "displayName": "JustSend Work Memory",
  "version": "0.4.0",
  "description": "Work records and a verification contract for coding agents: one record per task_key, evidence that has to exist before a task can be called done.",
  "author": {
    "name": "clab-one",
    "url": "https://github.com/clab-one"
  },
  "homepage": "https://github.com/clab-one/justsend-plugin",
  "repository": "https://github.com/clab-one/justsend-plugin",
  "license": "MIT",
  "keywords": [
    "work-log",
    "memory",
    "justsend",
    "verification",
    "evidence"
  ],
  "userConfig": {
    "node_path": {
      "type": "file",
      "title": "Node executable",
      "description": "Runs the bundled contract server. Leave as node to use the one on PATH.",
      "default": "node",
      "required": false
    }
  },
  "mcpServers": {
    "contract": {
      "type": "stdio",
      "command": "${user_config.node_path}",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/mcp/contract.mjs"
      ]
    }
  }
}
